# Django core
# SECRET_KEY: required whenever DEBUG=False — the app now refuses to boot
#   without it (fail-closed), instead of silently reusing the insecure
#   local-dev default. Never reuse that default in production.
# DEBUG: "True" or "False". Defaults to False (fail-closed) if unset.
#   Set to True locally to get the previous convenient dev behavior
#   (SECRET_KEY fallback, non-secure cookies). Must be False in production.
# ALLOWED_HOSTS: comma-separated. During the memoverse.com.br migration,
#   list BOTH the new API subdomain and the existing Render domain so the
#   backend keeps answering on either one, e.g.:
#   api.memoverse.com.br,my-backend.onrender.com
# CSRF_TRUSTED_ORIGINS: comma-separated, full origin with scheme. Same
#   parallel-domains approach during the migration, e.g.:
#   https://api.memoverse.com.br,https://my-backend.onrender.com
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# CORS
# CORS_ALLOWED_ORIGINS: comma-separated, full origin with scheme — the
#   frontend's public URL(s). Requests from any origin NOT listed here are
#   rejected by the browser. During the memoverse.com.br migration, list
#   BOTH the new domains and the existing Vercel domain in parallel, e.g.:
#   https://memoverse.com.br,https://www.memoverse.com.br,https://memoverse.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security (cookies/HTTPS)
# Default to secure automatically once DEBUG=False — only override if you
# need something different from that. SECURE_HSTS_SECONDS stays opt-in
# (0/disabled) even in production: enabling HSTS is hard to safely undo,
# see Django's own warning before setting this above 0.
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_HSTS_SECONDS=0

# Database
# DATABASE_URL: leave empty for local SQLite. Set to a Postgres URL
#   (postgres://user:password@host:port/dbname) in production, e.g. the
#   connection string a Render Postgres instance provides.
DATABASE_URL=

# Mercado Pago
# MP_ACCESS_TOKEN: server-side only, never expose to the frontend.
# MP_PUBLIC_KEY: safe to expose to the frontend.
# MP_ENV: "sandbox" or "production".
# MP_WEBHOOK_SECRET: server-side only. Suas integrações > Webhooks >
#   Configurar notificação > revelar chave secreta. Used to validate the
#   x-signature header on incoming webhook notifications.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_ENV=sandbox
MP_WEBHOOK_SECRET=

# Cloudflare R2 (media storage)
# Required for photo/video upload (MediaUploadIntentView) and public
# experience playback (PublicExperienceView) to work. The app boots
# without them, but those endpoints return 503 until all four are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PRESIGNED_URL_TTL_SECONDS=900

# Email (password reset — apps.accounts.services.email_service)
# EMAIL_BACKEND: leave unset for the console backend (prints to the
#   runserver terminal, sends nothing) — good enough for local dev.
#   Automatically overridden to locmem during `manage.py test`.
# RESEND_API_KEY: leave empty to keep using EMAIL_BACKEND above (dev/test).
#   Set it in production to actually send through Resend
#   (https://resend.com) — never commit the real value.
# DEFAULT_FROM_EMAIL: onboarding@resend.dev is Resend's own test sender,
#   usable without verifying a domain. Switch to something like
#   noreply@memoverse.com.br once that domain is verified in Resend —
#   never assume the test sender is the permanent one.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev
