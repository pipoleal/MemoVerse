# Django core
# SECRET_KEY: required in production, never reuse the local dev default.
# DEBUG: "True" or "False". Must be False in production.
# ALLOWED_HOSTS: comma-separated, e.g. my-backend.onrender.com
# CSRF_TRUSTED_ORIGINS: comma-separated, full origin with scheme,
#   e.g. https://my-backend.onrender.com
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database
# DATABASE_URL: leave empty for local SQLite. Set to a Postgres URL
#   (postgres://user:password@host:port/dbname) in production, e.g. the
#   connection string a Render Postgres instance provides.
DATABASE_URL=

# Mercado Pago
# MP_ACCESS_TOKEN: server-side only, never expose to the frontend.
# MP_PUBLIC_KEY: safe to expose to the frontend.
# MP_ENV: "sandbox" or "production".
# MP_WEBHOOK_SECRET: server-side only. Suas integrações > Webhooks >
#   Configurar notificação > revelar chave secreta. Used to validate the
#   x-signature header on incoming webhook notifications.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_ENV=sandbox
MP_WEBHOOK_SECRET=
