# Base URL of the backend API, consumed by frontend/lib/api.ts.
# Local development default (matches the previous hardcoded value):
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Production value (set this in the frontend host's environment config,
# e.g. Vercel — do not hardcode it in source). This is a NEXT_PUBLIC_*
# variable: it is baked into the client bundle at build time, so changing
# it requires a new deploy, not just a dashboard save.
#
# During the memoverse.com.br migration, this points to whichever backend
# is currently live — update it to the new API subdomain only once that
# backend is confirmed working, keeping the option to roll back to the
# existing Render URL below in the meantime:
# NEXT_PUBLIC_API_URL=https://api.memoverse.com.br/api
# NEXT_PUBLIC_API_URL=https://memoverse-backend.onrender.com/api

# Mercado Pago
# NEXT_PUBLIC_MP_PUBLIC_KEY: safe to expose to the browser (it is the public
# counterpart of the backend's MP_ACCESS_TOKEN, never the token itself).
# Used by frontend/components/checkout/CardPaymentBlock.tsx to initialize
# the Card Payment Brick. Must match the same MP_ENV (sandbox/production) as
# the backend's credentials — a sandbox public key with a production access
# token (or vice versa) will fail at Mercado Pago's side.
NEXT_PUBLIC_MP_PUBLIC_KEY=
