# Base URL of the backend API, consumed by frontend/lib/api.ts.
# Local development default (matches the previous hardcoded value):
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Production value (set this in the frontend host's environment config,
# e.g. Render/Vercel — do not hardcode it in source):
# NEXT_PUBLIC_API_URL=https://memoverse-backend.onrender.com/api
