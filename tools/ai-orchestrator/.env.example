# Copie este arquivo para ".env" nesta mesma pasta e preencha os valores reais.
# NUNCA cole sua chave real fora deste .env local. Este arquivo (.env) já está
# no .gitignore do repositório (regra ".env" / ".env.*" em /.gitignore).

# Obrigatória para a etapa de revisão do GPT. Sem ela, o orquestrador ainda
# funciona (Claude implementa, humano decide), mas pula a revisão automática.
OPENAI_API_KEY=

# Modelo da OpenAI usado para revisão. Padrão: gpt-4o
OPENAI_MODEL=gpt-4o

# Modo de permissão passado para `claude -p --permission-mode <valor>`.
# Valores possíveis (da própria CLI): acceptEdits | auto | bypassPermissions | manual | dontAsk | plan
# Padrão: acceptEdits (aceita edições de arquivo automaticamente; NÃO é o
# mesmo que bypassPermissions/--dangerously-skip-permissions).
# Se quiser aprovar cada ação manualmente, use: manual
CLAUDE_PERMISSION_MODE=acceptEdits

# Opcional. Deixe vazio para usar o modelo padrão configurado na sua CLI do Claude Code.
CLAUDE_MODEL=

# Limites de segurança contra loop infinito Claude <-> GPT.
MAX_GPT_REVIEWS=3
MAX_CORRECTION_ATTEMPTS=3

# Timeout (segundos) para cada execução do Claude CLI.
CLAUDE_TIMEOUT_SECONDS=1800
